# Copiez ce fichier en .env (ou exportez ces variables) puis adaptez les valeurs.

# Mode simulation : true = dossier fictif, aucun appel au connecteur OpenHR
MOCK_MODE=true

# Port d'écoute du serveur web (page Fiche collaborateur)
PORT=3000

# URL du connecteur Java OpenHR (voir connector-java/)
CONNECTOR_URL=http://localhost:8091
# Timeout des appels au connecteur (ms)
CONNECTOR_TIMEOUT_MS=15000
