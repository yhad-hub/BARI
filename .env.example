# Copiez ce fichier en .env (ou exportez ces variables) puis adaptez les valeurs.

# Mode simulation : true = données de démonstration, aucun appel à OpenHR
MOCK_MODE=true

# Port d'écoute du serveur web
PORT=3000

# --- Connexion OpenHR (HR Access Suite 9) ---
# URL du web service OpenHR exposé par le serveur HRa
OPENHR_ENDPOINT=http://serveur-hra:8080/openhr/services/OpenHRService
# Compte de service autorisé à interroger le dossier salarié
OPENHR_USER=
OPENHR_PASSWORD=
# Rôle / population utilisé pour l'appel (selon paramétrage sécurité HRa)
OPENHR_ROLE=
# Timeout des appels SOAP (ms)
OPENHR_TIMEOUT_MS=15000
